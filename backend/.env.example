DATABASE_URL=postgresql://postgres:postgres@localhost:5432/argos
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
PORT=5000
NODE_ENV=development
UPLOAD_MAX_SIZE=10485760
ADMIN_EMAIL=admin@argosworldwide.com
ADMIN_INITIAL_PASSWORD=ChangeMe_2026!

# Outbound email for contact/mandate submission notifications.
# Without these set, notifications are logged to the console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Argos Worldwide Website <no-reply@argosworldwide.com>"
# Where new contact form / mandate submissions are sent.
CONTACT_NOTIFY_EMAIL=arthur@argosworldwide.com
